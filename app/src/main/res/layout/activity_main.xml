<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <WebView
        android:id="@+id/web_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:indeterminateTint="#53FC18"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_toast"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp"
        android:textColor="#EAF2F8"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/txt_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/live"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_channel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="maherco"
                android:textColor="#EAF2F8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textColor="#9FB0BE"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_account"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/account"
                android:padding="12dp"
                android:src="@drawable/ic_person" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/settings"
                android:padding="12dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/center_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/playback"
                android:padding="20dp"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btn_live_edge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="22dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/go_live"
                android:padding="14dp"
                android:src="@drawable/ic_live_edge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingTop="30dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/mute"
                android:padding="12dp"
                android:src="@drawable/ic_volume_up" />

            <SeekBar
                android:id="@+id/seek_volume"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:progressBackgroundTint="#4DFFFFFF"
                android:progressTint="#53FC18"
                android:thumbTint="#53FC18" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_quality"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/ctrl_bg"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/auto"
                android:textColor="#EAF2F8"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_aspect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/aspect"
                android:padding="12dp"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/btn_reload"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/reload"
                android:padding="12dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_settings"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="#EAF2F8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close_panel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ctrl_bg"
                android:contentDescription="@string/close"
                android:padding="10dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
